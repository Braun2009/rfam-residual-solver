; Vortex 3D cold-air SST r8: validate initialization after pressure-far-field Mach fix.
; Source case: r7, with ideal-gas air, energy, density-based implicit SST,
; five physical boundaries, standard initialization, and farfield Mach = 0.01.
; This never overwrites the final mesh or source cases.

(format #t "\nVORTEX_R8_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_farfield_mach_r7/cold_air_sst_mach001_configured.cas.h5
(format #t "\nVORTEX_R8_MACH001_CASE_READ_OK\n")
/mesh/check
(format #t "\nVORTEX_R8_SOLVER_MESH_CHECK_OK\n")

/solve/initialize/initialize
(format #t "\nVORTEX_R8_STANDARD_INITIALIZATION_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_initialized.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_initialized.dat.h5
(format #t "\nVORTEX_R8_INITIALIZED_CASE_DATA_WRITTEN\n")

/solve/iterate 1
(format #t "\nVORTEX_R8_ITERATE_1_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_1it.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_1it.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R8_INIT4_OK\n")
/exit yes
