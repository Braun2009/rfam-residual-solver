; Vortex 3D cold-air SST r9: 36-physical-core continuation from r8 1-iteration state.
; r8 already passed Solver mesh/check, standard initialization, and one SST iteration.
; Do not initialize again; retain r8 and write all r9 artifacts separately.

(format #t "\nVORTEX_R9_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_1it.cas.h5
/file/read-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_init4_mach001_r8/cold_air_sst_1it.dat.h5
(format #t "\nVORTEX_R9_R8_CASE_DATA_READ_OK\n")

; Conservative first parallel continuation.  The r8 case uses density-based implicit SST.
/solve/iterate 5
(format #t "\nVORTEX_R9_ITERATE_5_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_r9/cold_air_sst_6it.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_r9/cold_air_sst_6it.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R9_36PHYS_OK\n")
/exit yes
