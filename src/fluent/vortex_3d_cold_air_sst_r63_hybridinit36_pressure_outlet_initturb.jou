; Vortex 3D cold-air SST r63: isolated hybrid-initialization diagnostic.
; Source r58 retains pressure-outlet, CFL=1 and paired low-turbulence standard
; defaults (k=1e-4 m2/s2, omega=0.6575704158 1/s).  Test Fluent's explicit
; hybrid initializer only; do not iterate.  Save outputs in this new directory
; and never alter r58, r59/r61, r2, or the final mesh.

(format #t "\nVORTEX_R63_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_config_r58/cold_air_sst_init_turbulence_configured.cas.h5
(format #t "\nVORTEX_R63_CONFIGURED_CASE_READ_OK\n")
/mesh/check
(format #t "\nVORTEX_R63_SOLVER_MESH_CHECK_OK\n")
/solve/initialize/hyb-initialization
(format #t "\nVORTEX_R63_HYBRID_INITIALIZATION_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_hybrid_initturb_init36_r63/cold_air_sst_hybrid_initialized.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_hybrid_initturb_init36_r63/cold_air_sst_hybrid_initialized.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R63_PRESSURE_OUTLET_HYBRID_INIT36_OK\n")
/exit yes
