; Read-only TUI command-list probe for Fluent initialization commands.
; Source r58 is immutable.  This journal only lists /solve/initialize commands;
; it never initializes, iterates, modifies mesh, or writes case/data.

(format #t "\nVORTEX_R73_INIT_TUI_PROBE_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_config_r58/cold_air_sst_init_turbulence_configured.cas.h5
(format #t "\nVORTEX_R73_SOURCE_CASE_READ_OK\n")
/solve/initialize/?
(format #t "\nVORTEX_R73_INIT_TUI_PROBE_OK\n")
/exit yes
