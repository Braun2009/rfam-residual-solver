; Vortex full-360 3D cold-air SST commissioning, Fluent-native journal.
; Source case already contains: ideal-gas air, energy, density-based implicit,
; SST k-omega, five required boundary zones, stationary adiabatic walls, and
; low-flow (0.25% design) mass-flow inlet conditions.
; This journal avoids the PyFluent initialization RPC that hung after case read.

(format #t "\nVORTEX_R4_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_commission_20260815_r2/cold_air_sst_configured.cas.h5
(format #t "\nVORTEX_R4_CONFIGURED_CASE_READ_OK\n")

; Standard flow initialization, not hybrid initialization.
/solve/initialize/initialize
(format #t "\nVORTEX_R4_STANDARD_INITIALIZATION_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_journal_20260815_r4_36phys/cold_air_sst_initialized.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_journal_20260815_r4_36phys/cold_air_sst_initialized.dat.h5
(format #t "\nVORTEX_R4_INITIALIZED_CHECKPOINT_WRITTEN\n")

; First conservative solver-chain commissioning increment.
/solve/iterate 5
(format #t "\nVORTEX_R4_ITERATE_5_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_journal_20260815_r4_36phys/cold_air_sst_commissioning_5it.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_journal_20260815_r4_36phys/cold_air_sst_commissioning_5it.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R4_OK\n")
/exit yes
