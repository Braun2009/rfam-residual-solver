Rotate { Volume{head3}; }{ {0,0,0}, {1,0,0}, 90.40000000000002*Pi/180 };
Translate { Volume{head3}; }{ 0, -0.08726575372452153, 12.499695383817434 };

fluid = newv; BooleanDifference{ Volume{cham, plume}; Delete; }{ Volume{vol_plate, head1, head2, head3}; Delete; };

Physical Volume("fluid", 1) = { fluid };
Printf("GEO_GEN_DONE");
