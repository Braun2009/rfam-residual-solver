pf1 = newp; Point(pf1) = {406.5, 60, 0, 10};
pf2 = newp; Point(pf2) = {1406.5, 60, 0, 30};
pf3 = newp; Point(pf3) = {1406.5, 300, 0, 60};
pf4 = newp; Point(pf4) = {406.5, 300, 0, 60};
lf1 = newl; Line(lf1) = {pf1, pf2};
lf2 = newl; Line(lf2) = {pf2, pf3};
lf3 = newl; Line(lf3) = {pf3, pf4};
lf4 = newl; Line(lf4) = {pf4, pf1};
llf = newll; Curve Loop(llf) = {lf1, lf2, lf3, lf4};
sf = news; Plane Surface(sf) = {llf};
plume = newv; Revolve(plume) = { {sf}, {}, {1,0,0}, 2*Pi };

vol_plate = newv; Cylinder(vol_plate) = {0, 0, -8, 0, 0, 8, 24};

// pintle 1
p1l0 = newp; Point(p1l0) = {0, 0, 0, 0.6};
p1l1 = newp; Point(p1l1) = {0, 7.5, 0, 0.6};
p1l2 = newp; Point(p1l2) = {13, 12.4, 0, 0.6};
l1l1 = newl; Line(l1l1) = {p1l0, p1l1};
l1l2 = newl; Line(l1l2) = {p1l1, p1l2};
l1l3 = newl; Line(l1l3) = {p1l2, p1l0};
ll1l = newll; Curve Loop(ll1l) = {l1l1, l1l2, l1l3};
s1l = news; Plane Surface(s1l) = {ll1l};
vol1l = newv; Extrude{{0,0,1},{0,0,0}, -21.8*Pi/180}{Surface{s1l}; Layers{1}; Recombine;};
vol1l2 = newv; Extrude{{0,0,1},{0,0,0}, 21.8*Pi/180}{Surface{s1l}; Layers{1}; Recombine;};
fused1l = newv; BooleanFusion{ Volume{vol1l, vol1l2}; Delete; };
p1c1 = newp; Point(p1c1) = {13, 12.4, 0, 0.6};
p1c2 = newp; Point(p1c2) = {26, 17.3, 0, 0.6};
l1c1 = newl; Line(l1c1) = {p1l0, p1c1};
l1c2 = newl; Line(l1c2) = {p1c1, p1c2};
l1c3 = newl; Line(l1c3) = {p1c2, p1l0};
ll1c = newll; Curve Loop(ll1c) = {l1c1, l1c2, l1c3};
s1c = news; Plane Surface(s1c) = {ll1c};
vol1c = newv; Extrude{{0,0,1},{0,0,0}, -21.8*Pi/180}{Surface{s1c}; Layers{1}; Recombine;};
vol1c2 = newv; Extrude{{0,0,1},{0,0,0}, 21.8*Pi/180}{Surface{s1c}; Layers{1}; Recombine;};
fused1c = newv; BooleanFusion{ Volume{vol1c, vol1c2}; Delete; };
frust1 = newv; BooleanFusion{ Volume{fused1l, fused1c}; Delete; };
hemi1 = newv; Sphere(hemi1) = {21.4, 0, 0, 4.6};
head1 = newv; BooleanFusion{ Volume{frust1, hemi1}; Delete; };
Rotate { Volume{head1}; }{ {0,0,0}, {1,0,0}, -150.7*Pi/180 };
Translate { Volume{head1}; }{ 0, -10.900865905401506, -6.117280646860581 };
