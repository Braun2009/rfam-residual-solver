; Vortex 3D cold-air SST r59: pressure-outlet with paired ambient SST init defaults.
; Source r58 differs from immutable r34 only in stored standard-initialization
; defaults: k=1e-4 m2/s2 and omega=0.6575704158 1/s, implying mu_t/mu=10 at
; the 300 K, 1 atm ideal-air initialization state.  Keep CFL=1, perform
; mesh/check, standard initialization and a bounded 5-iteration comparison.

(format #t "\nVORTEX_R59_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_config_r58/cold_air_sst_init_turbulence_configured.cas.h5
(format #t "\nVORTEX_R59_CONFIGURED_CASE_READ_OK\n")
/mesh/check
(format #t "\nVORTEX_R59_SOLVER_MESH_CHECK_OK\n")
/solve/initialize/initialize
(format #t "\nVORTEX_R59_STANDARD_INITIALIZATION_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_init36_r59/cold_air_sst_initialized.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_init36_r59/cold_air_sst_initialized.dat.h5
(format #t "\nVORTEX_R59_INITIALIZED_CASE_DATA_WRITTEN\n")
/solve/iterate 5
(format #t "\nVORTEX_R59_ITERATE_5_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_init36_r59/cold_air_sst_5it.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_initturb_init36_r59/cold_air_sst_5it.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R59_PRESSURE_OUTLET_INITTURB_INIT36_OK\n")
/exit yes
