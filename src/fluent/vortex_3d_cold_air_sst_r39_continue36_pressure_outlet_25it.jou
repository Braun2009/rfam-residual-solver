; Vortex 3D cold-air SST r39: pressure-outlet farfield continuation at CFL=1.
; Source r37 passed 30 iterations without limiters/FPE.  Its external-domain
; outlet backflow area is declining, so retain conservative CFL=1 and continue
; one bounded 25-iteration segment.  No reinitialization; source immutable.

(format #t "\nVORTEX_R39_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_continue36_r37/cold_air_sst_30it.cas.h5
/file/read-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_continue36_r37/cold_air_sst_30it.dat.h5
(format #t "\nVORTEX_R39_R37_CASE_DATA_READ_OK\n")
/solve/iterate 25
(format #t "\nVORTEX_R39_ITERATE_25_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_continue36_r39/cold_air_sst_55it.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_pressure_outlet_continue36_r39/cold_air_sst_55it.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R39_PRESSURE_OUTLET_36PHYS_OK\n")
/exit yes
