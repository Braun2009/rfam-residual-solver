; Vortex 3D cold-air SST r24: recovery continuation from last stable CFL=5 state.
; Deliberately does NOT use r23 (invalid high-CFL divergence branch).
; Source r18 at iteration 55, farfield Mach=1e-6, Courant=5.
; No initialization; preserve source and write all output here.

(format #t "\nVORTEX_R24_JOURNAL_BEGIN\n")
/file/read-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_cfl5_r18/cold_air_sst_55it_cfl5.cas.h5
/file/read-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_cfl5_r18/cold_air_sst_55it_cfl5.dat.h5
(format #t "\nVORTEX_R24_R18_STABLE_CASE_DATA_READ_OK\n")
/solve/iterate 25
(format #t "\nVORTEX_R24_ITERATE_25_OK\n")
/file/write-case /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_cfl5_r24/cold_air_sst_80it_cfl5.cas.h5
/file/write-data /root/vortex_fluent/gmsh_fixed_v2/solver_cold_air_sst_continue36_cfl5_r24/cold_air_sst_80it_cfl5.dat.h5
(format #t "\nVORTEX_3D_COLD_AIR_SST_R24_CFL5_36PHYS_OK\n")
/exit yes
