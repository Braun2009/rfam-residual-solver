  "residual_formulas": {
    "relative_formula": "abs(actual-reference)/max(abs(actual),abs(reference),scale_floor)",
    "relative_scale_floors": {
      "pressure_pa": 1.0,
      "temperature_k": 1.0,
      "compressibility_z": 1.0,
      "density_kg_m3": 1.0,
      "specific_internal_energy_j_kg": 1.0,
      "specific_enthalpy_j_kg": 1.0
    },
    "mass_fraction_l1_formula": "sum_i(abs(actual_y_i-reference_y_i))",
    "eos_root_formula": "abs(z3+(b-1)z2+(a-3b2-2b)z-(ab-b2-b3))/max(abs(z3)+abs((b-1)z2)+abs((a-3b2-2b)z)+abs(ab-b2-b3),1e-300)",
    "departure_caloric_formula": "abs(e-(h-p/rho))/max(abs(e),abs(h),abs(p/rho),1.0-j-kg)",
    "cv_minus_dedt_rho_formula": "abs(cv-dedt_rho)/max(abs(cv),abs(dedt_rho),1.0-j-kg-k)",
    "root_continuity_formula": "0.0-if-parent-phase-root-token-lineage-and-root-ordinal-all-exact-otherwise-failure-no-success-result",
    "required_residuals": ["pressure_relative", "temperature_relative", "compressibility_relative", "density_relative", "specific_internal_energy_relative", "specific_enthalpy_relative", "mass_fraction_l1", "eos_root", "departure_caloric", "cv_minus_dedt_rho", "root_continuity"],
    "acceptance_max": {
      "pressure_relative": 1e-8,
      "temperature_relative": 1e-8,
      "compressibility_relative": 1e-8,
      "density_relative": 1e-8,
      "specific_internal_energy_relative": 1e-8,
      "specific_enthalpy_relative": 1e-8,
      "mass_fraction_l1": 1e-10,
      "eos_root": 1e-8,
      "departure_caloric": 1e-8,
      "cv_minus_dedt_rho": 1e-8,
      "root_continuity": 0.0
    },
    "acceptance_policy": "all-required-residuals-finite-nonnegative-and-at-or-below-own-bound-before-token-issuance"
  },
  "applicability_envelope": {
